{
  "name": "santana-motor",
  "description": "A Progressive Web App for Santana Motor, showcasing motorcycles and providing a seamless user experience.",
  "type": "project",
  "require": {
    "php": "^7.4 || ^8.0",
    "codeigniter4/framework": "^4.0",
    "guzzlehttp/guzzle": "^7.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "php artisan package:discover --ansi"
    ]
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}